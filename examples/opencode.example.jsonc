// Generated by `urai-router setup opencode`; this is an illustration.
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "urai-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Urai Router (auto keys)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "urai-local"
      },
      "models": {
        "opencode/deepseek-v4.1-flash-free": {
          "name": "★ DeepSeek V4.1 Flash Free",
          "limit": { "context": 200000, "output": 32000 }
        },
        "opencode/glm-5.3-flash-free": {
          "name": "★ GLM-5.3-Flash Free",
          "limit": { "context": 200000, "output": 32000 }
        },
        "opencode/big-pickle": {
          "name": "★ Big Pickle",
          "limit": { "context": 200000, "output": 32000 }
        }
      }
    }
  },
  "mcp": {
    "urai-router": {
      "type": "local",
      "command": ["urai-router", "mcp"],
      "enabled": true,
      "environment": {
        "URAI_KEYS_FILE": "/home/YOU/.config/urai-router/keys.txt"
      }
    }
  }
}
